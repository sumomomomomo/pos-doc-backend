MINIO_ROOT_USER=local-dev-access
MINIO_ROOT_PASSWORD=local-dev-secret-change-me
MINIO_BUCKET=pos-documents
RABBITMQ_USERNAME=local-dev-rabbit
RABBITMQ_PASSWORD=local-dev-rabbit-secret-change-me
# Set to false in phase 1 of the whole-stack verification so a queued
# message survives a RabbitMQ restart; true (the default) re-enables the
# consumer for phase 2.
INGESTION_CONSUMER_ENABLED=true

# --- Security (Google OIDC) ---
# In the default "google" mode these are required (fail-closed at startup).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from the Google Cloud OAuth
# client. The authorized redirect URI must include the /api/v1 servlet context
# path: local development http://localhost:18080/api/v1/login/oauth2/code/google,
# production https://sumomo.horse/api/v1/login/oauth2/code/google.
# Register both (or the one you deploy) in the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Comma-separated Google OIDC subject ("sub") values (the stable numeric id of
# each approved account). Leave a list empty for a reviewer-only or viewer-only
# deployment; at least one of the two lists must be non-empty (enforced at startup).
APP_SECURITY_MODE=google
APP_SECURITY_GOOGLE_VIEWER_SUBJECTS=
APP_SECURITY_GOOGLE_REVIEWER_SUBJECTS=
# Comma-separated exact browser origins allowed to call the API cross-origin.
# Leave EMPTY in production: the frontend and API are the same origin behind the
# Nginx reverse proxy (the browser calls https://sumomo.horse/api/v1/... and Nginx
# proxies internally), so no CORS is needed. Set origins only for a genuinely
# cross-origin deployment.
APP_SECURITY_ALLOWED_ORIGINS=
# Absolute path the user is redirected to after a successful login. Defaults to
# the POS application subpage (the frontend serves the POS app at /pos/).
APP_SECURITY_POST_LOGIN_REDIRECT=/pos/
# Only used when APP_SECURITY_MODE=stack-test: a 64+ hex-char bearer token.
APP_SECURITY_STACK_TEST_TOKEN=

# --- OCR (llama.cpp serving Qwen 3.5 8B) ---
# Production Compose fails to start if OCR_MODEL is empty. The value is
# deployment-specific: copy the EXACT data[0].id reported by
# GET http://192.168.1.34:8080/models and put it here. Do NOT guess a model
# filename. The backend validates that every OCR response's "model" field equals
# this value exactly (fail-closed). The placeholder below exists only so that
# `docker compose config` syntax validation passes; replace it with the real
# model ID in your production .env before deploying.
OCR_MODEL=change-me
# Optional: override the llama.cpp server origin. Defaults to
# http://192.168.1.34:8080 (the LAN model server). Leave as-is for production.
OCR_SERVER_ORIGIN=http://192.168.1.34:8080
