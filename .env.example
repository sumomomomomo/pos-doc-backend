MINIO_ROOT_USER=local-dev-access
MINIO_ROOT_PASSWORD=local-dev-secret-change-me
MINIO_BUCKET=pos-documents
RABBITMQ_USERNAME=local-dev-rabbit
RABBITMQ_PASSWORD=local-dev-rabbit-secret-change-me
# Set to false in phase 1 of the whole-stack verification so a queued
# message survives a RabbitMQ restart; true (the default) re-enables the
# consumer for phase 2.
INGESTION_CONSUMER_ENABLED=true

# --- Security (Google OIDC) ---
# In the default "google" mode these are required (fail-closed at startup).
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET come from the Google Cloud OAuth
# client (authorized redirect URI: http://localhost:18080/login/oauth2/code/google).
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Comma-separated Google OIDC subject ("sub") values. Viewers can list/search
# records; reviewers (a superset) can also verify, delete, and open content.
APP_SECURITY_MODE=google
APP_SECURITY_GOOGLE_VIEWER_SUBJECTS=your-viewer-subject-id
APP_SECURITY_GOOGLE_REVIEWER_SUBJECTS=your-reviewer-subject-id
# Comma-separated exact browser origins allowed to call the API cross-origin.
# Leave empty to disable CORS entirely (same-origin only).
APP_SECURITY_ALLOWED_ORIGINS=
# Absolute path the user is redirected to after a successful login.
APP_SECURITY_POST_LOGIN_REDIRECT=/
# Only used when APP_SECURITY_MODE=stack-test: a 64+ hex-char bearer token.
APP_SECURITY_STACK_TEST_TOKEN=
